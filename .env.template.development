# hyrax-coar-notify: the external COAR Notify inbox service (not mounted in this app)
COAR_NOTIFY_USE_LOCAL=false
COAR_NOTIFY_BASE_URL=http://localhost:3001
COAR_NOTIFY_ADMIN_API_TOKEN=
COAR_NOTIFY_INBOX_URL=http://localhost:3001/coar_notify_inbox/notifications
# Optional: default origin inbox URL sent with outgoing requests
COAR_NOTIFY_DEFAULT_ORIGIN_INBOX=
# Optional: sent when registering a consumer, only effective with an inbox admin token
COAR_NOTIFY_INBOX_USERNAME=
# Role allowed to manage Notify connections (documented by the gem; access is granted in app/models/ability.rb)
NOTIFY_MANAGER_ROLE=admin

# Solr setting
SOLR_URL_SCHEME=http
SOLR_HOST=solr
SOLR_PORT=8983
SOLR_CORE=hyrax_production
SOLR_TEST_PORT=8983
SOLR_TEST_CORE=hyrax_test

# Database setting
POSTGRES_HOST_APP=appdb
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB_APP=hyrax_production
POSTGRES_DB_TEST=hyrax_test

# Redis setting
REDIS_HOST=redis
REDIS_PORT=6379
# Optional: overrides REDIS_HOST/REDIS_PORT
# REDIS_URL=redis://redis:6379/1
HYRAX_ACTIVE_JOB_QUEUE=sidekiq

# RAILS setting
LANG=C.UTF-8
PORT=3000
RAILS_ENV=development
RAILS_MAX_THREADS=5
# Required in production. Use "$ bundle exec rails secret" to generate a very long random key.
SECRET_KEY_BASE=
# used for production
RAILS_FORCE_SSL=false

# Hyrax application setting
HOST_APP_DATA_PATH=./data/
# DERIVATIVES_PATH is used by Docker build and is therefore fixed in the resulting Docker image
DERIVATIVES_PATH=/shared/derivatives/
# FITS_PATH and FITS_VERSION are used by Docker build and are therefore fixed in the resulting Docker image
FITS_PATH=/fits/fits-1.5.5/fits.sh
FITS_VERSION=1.5.5
# UPLOADS_PATH is used by Docker build and is therefore fixed in the resulting Docker image
UPLOADS_PATH=/shared/uploads/
# CACHE_PATH is used by Docker build and is therefore fixed in the resulting Docker image
CACHE_PATH=/shared/cache/
# DOWNLOAD_PATH is used by Docker build and is therefore fixed in the resulting Docker image
DOWNLOAD_PATH=/shared/downloads
DEFAULT_DATE_FORMAT=%Y-%m-%d
CONTACT_FORM_SUBJECT_PREFIX='Hyrax Contact form:'
GEONAMES=
USE_BROWSE_EVERYTHING=false

# APPLICATION_URL should not have trailing slash
APPLICATION_URL=http://localhost:3000

# Valkyrie config
VALKYRIE_METADATA_ADAPTER=pg_metadata
